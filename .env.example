# Copy to .env and fill in. .env is gitignored. Worktrees symlink to the main repo's .env.
# Local values below match `supabase start` defaults; for production use the hosted project's.

# --- Database + auth (Supabase) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=            # backend only: admin user deletion. `supabase status` prints the local one
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # safe for the browser. `supabase status` prints the local one

# --- Redis (docker compose) ---
REDIS_URL=redis://localhost:6379/0

# --- Data providers (ingestion lane only) ---
API_FOOTBALL_KEY=
ODDS_API_KEY=
ODDS_CADENCE=lean                     # 'lean' fits The Odds API free tier (~300 credits/mo); 'full' = SPEC cadence, needs the 20K plan
API_FOOTBALL_SEASON=2026               # season start year: 2026 = 2026/27. Free plan only serves 2022-2024
API_FOOTBALL_MIN_INTERVAL=0.2         # seconds between requests: 0.2 on Pro (300/min), 6.5 on free (10/min)

# --- AI ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL_FAST=claude-sonnet-5-5
CLAUDE_MODEL_STRONG=claude-opus-5-5   # value questions (compare_to_market)
VOYAGE_API_KEY=                       # not needed until news is enabled
VOYAGE_MODEL=voyage-4                 # 1024 dims, matches news_chunks.embedding

# --- Monitoring (needed by day 8) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- App config (not secrets) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000   # API: comma-separated web origins; the Vercel URL in production
FORWARDED_ALLOW_IPS=127.0.0.1             # uvicorn: proxies trusted for X-Forwarded-For; Railway's proxy range in production
NEWS_ENABLED=false
DAILY_QUESTION_LIMIT=15
PER_IP_REQUESTS_PER_MINUTE=10
DAILY_TOKEN_BUDGET=                   # open decision
VALUE_EDGE_THRESHOLD=                 # open decision, e.g. 0.03
