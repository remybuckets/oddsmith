# Copy to .env and fill in. .env is gitignored. Worktrees symlink to the main repo's .env.

# --- Local infrastructure (docker compose) ---
DATABASE_URL=postgresql://oddsmith:oddsmith@localhost:5433/oddsmith
REDIS_URL=redis://localhost:6379/0

# --- Data providers (ingestion lane only) ---
API_FOOTBALL_KEY=
ODDS_API_KEY=

# --- AI ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# --- Supabase (users + auth) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=            # backend only: profile updates, account deletion
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # safe for the browser

# --- Monitoring (needed by day 8) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- App config (not secrets) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
DAILY_QUESTION_LIMIT=15
PER_IP_REQUESTS_PER_MINUTE=10
DAILY_TOKEN_BUDGET=                   # open decision
VALUE_EDGE_THRESHOLD=                 # open decision, e.g. 0.03
CLAUDE_MODEL_FAST=                    # open decision
CLAUDE_MODEL_STRONG=                  # open decision
VOYAGE_MODEL=                         # must output 1024 dims
